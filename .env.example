# Copy to `.env` and fill in. Only needed for the `run_all.sh --full` pipeline.
# The default `run_all.sh --figures` tier needs none of these.

# HuggingFace access token. Required for the gated Llama-3.2-1B scaling run
# (scaling_llama32_1b.py, scaling_omp_ce.py). On Modal, also register it as a
# secret:  modal secret create huggingface HF_TOKEN=hf_xxx
HF_TOKEN=

# Blinded LLM feature-coherence eval (experiments/feature_dashboard_eval.py).
# Uses Claude + GPT-4o as judges; ~$5-7 of API spend for a full run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
